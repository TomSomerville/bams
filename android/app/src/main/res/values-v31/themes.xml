<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the start screen (splash) in the web UI's background, the logo with no light circle behind it -->
    <style name="Theme.Bams" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/bg</item>
    </style>
</resources>
