# BAMS systemd unit (Debian / Ubuntu / Linux Mint), installed by the bams .deb.
#
# The kernel enforces read-only media here, not just BAMS: with ProtectSystem=strict the whole
# filesystem is read-only to this service except StateDirectory (/var/lib/bams), and
# ProtectHome=read-only covers /home. Media anywhere (/home, /mnt, /media, /srv) is therefore
# read-only to BAMS even if the account it runs as could write there.
#
# Settings live in /etc/default/bams (address, port, the account BAMS runs as). The package writes
# that file once and never overwrites it; postinst turns BAMS_USER into a drop-in
# (/etc/systemd/system/bams.service.d/10-user.conf). After editing it: sudo dpkg-reconfigure bams
#
# Without the package (manual install into /opt/bams/venv):
#   sudo useradd --system --home /var/lib/bams --shell /usr/sbin/nologin bams
#   sudo cp bams.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now bams
# Grant read access to the media (see docs/READ-ONLY.md), e.g.:
#   sudo setfacl -R -m u:bams:rX /mnt/media && sudo setfacl -R -d -m u:bams:rX /mnt/media

[Unit]
Description=BAMS - Bad Ass Media Server
Documentation=https://github.com/TomSomerville/bams
Wants=network-online.target
After=network-online.target remote-fs.target

[Service]
Type=simple
User=bams
Group=bams
StateDirectory=bams
Environment=BAMS_DATA_DIR=/var/lib/bams BAMS_HOST=127.0.0.1 BAMS_PORT=8484 PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/default/bams
ExecStart=/opt/bams/venv/bin/python -m bams serve --host ${BAMS_HOST} --port ${BAMS_PORT}
Restart=on-failure
RestartSec=5

# --- read-only everything except our own state directory
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/bams
PrivateTmp=true
# --- general hardening
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
